{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": []
  },
  "build": {
    "beforeBuildCommand": "npm run build --workspace @agentx/web",
    "beforeDevCommand": "npm run dev --workspace @agentx/web",
    "devUrl": "http://localhost:3000",
    "frontendDist": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright \u00a9 2026 AgentX contributors",
    "licenseFile": "../../../LICENSE.txt",
    "resources": {
      "../../../apps/web/.next/standalone": "web",
      "../../../apps/web/.next/static": "web/.next/static"
    },
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "compression": "lzma",
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "languages": [
          "English"
        ]
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "identifier": "com.agentx.desktop",
  "productName": "AgentX",
  "version": "0.1.0"
}
